{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "top-list",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "routes": [
    {
      "pattern": "list.odeschenes.dev",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "top-list",
      "database_id": "ac6502c6-3187-4428-8ef2-5a65515a528c",
    },
  ],
  // Per-IP budgets for writes (every POST) and photo uploads (src/server.ts).
  "ratelimits": [
    {
      "name": "WRITE_LIMIT",
      "namespace_id": "7391",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "UPLOAD_LIMIT",
      "namespace_id": "7392",
      "simple": { "limit": 6, "period": 60 },
    },
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "top-list-photos",
    },
  ],
}
