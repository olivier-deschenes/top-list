{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "top-list",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "routes": [
    {
      "pattern": "list.odeschenes.dev",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "top-list",
      "database_id": "ac6502c6-3187-4428-8ef2-5a65515a528c",
    },
  ],
}
