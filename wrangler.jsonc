{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "top-list",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "routes": [
    {
      "pattern": "list.odeschenes.dev",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "top-list",
      "database_id": "ac6502c6-3187-4428-8ef2-5a65515a528c",
    },
  ],
  // Per-IP budgets for writes (every POST) and photo uploads (src/server.ts).
  // EMAIL_LIMIT caps link emails per IP, per recipient, and per group
  // (src/server/groups.functions.ts).
  "ratelimits": [
    {
      "name": "WRITE_LIMIT",
      "namespace_id": "7391",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "UPLOAD_LIMIT",
      "namespace_id": "7392",
      "simple": { "limit": 6, "period": 60 },
    },
    {
      "name": "EMAIL_LIMIT",
      "namespace_id": "7393",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
  // Sends a group's link to an address someone enters. The sender's domain
  // must be onboarded to Cloudflare Email Sending. Local dev only simulates it.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@odeschenes.dev"],
    },
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "top-list-photos",
    },
  ],
}
